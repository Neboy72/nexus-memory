{
  "name": "@neboy72/nexus-memory",
  "version": "1.21.8",
  "type": "module",
  "description": "OpenClaw Nexus Memory plugin — Auto-Recall + Auto-Capture over Qdrant + ingestion-time consolidation",
  "license": "MIT",
  "files": [
    "README.md",
    "openclaw.plugin.json",
    "index.ts",
    "logger.ts",
    "runtime.ts",
    "config.ts",
    "lib",
    "hooks",
    "tools",
    "types",
    "scripts",
    "dist"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --format=esm --platform=node --target=es2022 --external:openclaw --external:openclaw/* --external:@sinclair/typebox --outfile=dist/index.js",
    "check-types": "tsc --noEmit",
    "prepack": "npm run check-types && npm run build"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.7 <2027.0.0",
    "@sinclair/typebox": "^0.34.0"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.8",
      "minGatewayVersion": "2026.9.8"
    },
    "build": {
      "openclawVersion": "2026.9.8"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Neboy72/nexus-memory.git"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "@sinclair/typebox": "^0.34.0",
    "@types/node": "^22.0.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  }
}
